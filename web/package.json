{
  "name": "reclaim-console",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Operations console for the Reclaim payment recovery system",
  "scripts": {
    "dev": "concurrently -n vite,bff -c cyan,magenta \"vite\" \"node server/index.js\"",
    "dev:web": "vite",
    "dev:bff": "node server/index.js",
    "build": "tsc -b && vite build",
    "preview": "node server/index.js",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.62.0",
    "express": "^4.21.2",
    "http-proxy-middleware": "^3.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/express": "^5.0.0",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^2.1.8"
  }
}
