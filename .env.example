# Copy to .env for local development. Never commit real secrets.

DB_APP_URL=postgresql://recovery_app:recovery_app_test@localhost:5432/reclaim_dev
DB_VERIFIER_URL=postgresql://recovery_verifier:recovery_verifier_test@localhost:5432/reclaim_dev

# Superuser URL for migrations only
DATABASE_URL=postgresql://postgres@localhost:5432/reclaim_dev

# Test database (pytest)
TEST_DATABASE_ADMIN_URL=postgresql://postgres@localhost:5432/postgres
TEST_DATABASE_NAME=reclaim_test

# Razorpay. TEST MODE ONLY — the contract suite refuses any key that is not
# rzp_test_*. Leave blank to skip the provider contract tests.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
